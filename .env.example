# 评茶员初赛理论题库系统 - 环境变量配置

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=tea_exam

# 服务器配置
SERVER_PORT=8080
GIN_MODE=debug

# JWT 密钥
JWT_SECRET=tea-exam-secret-key-2024

# 仅用于全新数据库；本地开发默认 123456，生产环境必须显式设置强密码
ADMIN_INITIAL_PASSWORD=123456

# 本地是否创建张三、李四、王五示例账号；生产环境应设为 false
SEED_DEMO_USERS=true

# 允许跨域访问的前端来源，多个来源用逗号分隔；同域生产部署留空
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
