# 复制为 .env.production 后再填写。不要提交 .env.production。
HTTP_PORT=80

MYSQL_DATABASE=tea_exam
MYSQL_USER=tea_exam_app
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# 至少 32 个字符，建议执行 openssl rand -hex 32 生成。
JWT_SECRET=

# 仅在全新数据库首次启动时创建管理员账号，至少 12 个字符。
ADMIN_INITIAL_PASSWORD=

# 同域部署不需要跨域。以后如拆分前后端，可填逗号分隔的完整来源地址。
CORS_ALLOWED_ORIGINS=
